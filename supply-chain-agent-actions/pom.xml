<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.supplychain.agent</groupId>
        <artifactId>supply-chain-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>supply-chain-agent-actions</artifactId>
    <name>Supply Chain Agent — CoALA Internal and External Actions</name>
    <description>Framework-neutral typed action contracts, capability enforcement, memory actions, perception and simulator-backed grounding.</description>
    <dependencies>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-simulator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
