<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.supplychain.agent</groupId>
        <artifactId>supply-chain-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>supply-chain-agent-infrastructure-postgres</artifactId>
    <name>Supply Chain Agent — PostgreSQL Infrastructure</name>
    <description>PostgreSQL migrations, durable CoALA memory repositories and resumable planner-session checkpoints.</description>
    <dependencies>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-planning</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-actions</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.supplychain.agent</groupId>
            <artifactId>supply-chain-agent-mechanisms</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-postgres-saver</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
